<Window x:Class="GPMI_Laser_Marking.Import_Input_Order"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GPMI_Laser_Marking"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="Import Input Order" Height="700" Width="1200">
    <Window.Resources>
        <Style TargetType="RadioButton">
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1.3" ScaleY="1.3"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.Resources>
            <Style TargetType="TextBlock" BasedOn="{StaticResource NormalTextBlock}">
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="Margin" Value="40 0 0 0"/>
                <Setter Property="FontStyle" Value="Italic"/>
            </Style>
            <Style TargetType="TextBox" BasedOn="{StaticResource NormalTextBox}" >
                <Setter Property="Foreground" Value="Blue"/>
                <Setter Property="FontSize" Value="17"/>
            </Style>
        </Grid.Resources>
            <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="200"/>
            <RowDefinition Height="5*"/>
        </Grid.RowDefinitions>
        <Grid Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="300"/>             
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text=" Search"/>
            <TextBox x:Name="Search_value_txt" HorizontalAlignment="Stretch" Margin="5" VerticalContentAlignment="Center" Grid.Column="1"/>
            <Button FontSize="18" x:Name="Search_btn" Content="Search" Grid.Column="2" Margin=" 5" Click="Search_btn_Click"/>
            <RadioButton Margin="5 0" VerticalAlignment="Center" VerticalContentAlignment="Center" x:Name="partnumber_rbtn" Content="Part Number" Grid.Column="3" FontSize="16" IsChecked="True"/>
            <RadioButton VerticalAlignment="Center" VerticalContentAlignment="Center" x:Name="Vendor_rbtn" Content="Order No" Grid.Column="4" FontSize="16"/>
        </Grid>
        
        <Grid x:Name="Grid_info"  Grid.Row="1" Margin=" 0 0 0 20 ">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="400"/>
                        <ColumnDefinition Width="400"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel  Grid.RowSpan="5" Grid.Column="2">
                        <TextBlock Text="Note :" Margin="10"/>
                        <TextBox FontSize="15" AcceptsReturn="True"
                        HorizontalContentAlignment="Left"
                        VerticalScrollBarVisibility="Visible"  Height="140" 
                        TextWrapping="Wrap" x:Name="Note_txt"/>
                    </StackPanel>
                    <TextBlock Grid.ColumnSpan="2" FontWeight="Black">Order Infomation</TextBlock>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock>Part Number</TextBlock>
                        <TextBox x:Name="Part_Number" Grid.Column="1"></TextBox>
                    </Grid>
                    <Grid Grid.Row="1" Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock>Part Name</TextBlock>
                        <TextBox x:Name="Part_Name" Grid.Column="1"></TextBox>
                    </Grid>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock>Order No</TextBlock>
                        <TextBox x:Name="Order_No" Grid.Column="1" Background="#FFA5DA7B" ></TextBox>
                    </Grid>
                    <Grid Grid.Row="2" Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>
                        <DatePicker Margin="10,5"  Name="Order_date"  HorizontalContentAlignment="Center" Grid.Column="1"  FontSize="16"/>
                        <TextBlock>Order Date</TextBlock>
                    </Grid>
                    <StackPanel Grid.Row="3">
                        
                    </StackPanel>
                    <Grid Grid.Row="3">
                        <Grid.RowDefinitions>

                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock>Order Quantity</TextBlock>
                        <TextBox x:Name="Order_Quantity" Grid.Column="1"></TextBox>
                    </Grid>
                    <Grid Grid.Row="3" Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock>Pcs / Box</TextBlock>
                        <TextBox x:Name="Pcs_Box" Grid.Column="1"></TextBox>
                    </Grid>
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock>Vendor Code</TextBlock>
                        <TextBox x:Name="Vendor_Code" Grid.Column="1"></TextBox>
                    </Grid>
                    <Grid Grid.Row="4" Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock>Version</TextBlock>
                        <TextBox x:Name="Version" Grid.Column="1"></TextBox>
                    </Grid>

                </Grid>
            </Grid>
            <Grid x:Name="import_panel" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Button x:Name="Save_btn"  FontSize="20"  Grid.Row="2" Margin="20 5" Click="Save_btn_Click">Add</Button>
                <Button x:Name="UpdateBtn" FontSize="20" IsEnabled="False" Grid.Row="3" Margin="20 5" Click="UpdateBtn_Click">Update</Button>
                <Button FontSize="20" Grid.Row="1" Margin="20 5" Click="Button_Click">Import</Button>
            </Grid>


        </Grid>
        
        <DataGrid x:Name="Output_Grid" BorderThickness="2"  Grid.Row="2" FontSize="15" AutoGenerateColumns="False" CanUserAddRows="False" SelectedCellsChanged="Output_Grid_SelectedCellsChanged_1" LoadingRow="Output_Grid_LoadingRow" >
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="LightBlue"/>
                    <Setter Property="Height" Value="30"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="5 0"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="BorderBrush" Value="Black"/>

                </Style>
                <Style TargetType="DataGridCell">
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="5 0"/>
                    <Setter Property="BorderThickness" Value="3"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Part Number" Width="1.3*" Binding="{Binding Part_Number}"/>
                <DataGridTextColumn Header="Part Name" Width="1.5*" Binding="{Binding Part_Name}"/>
                <DataGridTextColumn Header="Order No" Width="1*" Binding="{Binding Order_No}"/>
                <DataGridTextColumn Header="Date Time" Width="1*" Binding="{Binding Order_Date, StringFormat={}{0:dd/MM/yyyy}}"/>
                <DataGridTextColumn Header="Quantity" Width=".5*" Binding="{Binding Order_Quantity}"/>
                <DataGridTextColumn Header="Pcs / Box" Width=".5*" Binding="{Binding Pcs_in_Box}"/>
                <DataGridTextColumn Header="Vendor Code" Width=".8*" Binding="{Binding Vendor_Code}"/>
                <DataGridTextColumn Header="Version" Width=".5*" Binding="{Binding Version}"/>
                <DataGridTextColumn Header="Account" Width=".5*" Binding="{Binding Input_Account}"/>
            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</Window>
