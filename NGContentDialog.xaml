<Window x:Class="GPMI_Laser_Marking.NGContentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NG Content" Height="224" Width="544"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="10">
        <StackPanel>
            <TextBlock Text="ENTER NG CONTENT:" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox x:Name="NGContentTextBox" Height="80" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,10" TextChanged="NGContentTextBox_TextChanged"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Delete" Width="100" Margin="0,0,10,0" Click="Clear_Click"/>
                <Button Content="OK" Width="75" Margin="0,0,10,0" Click="OK_Click"/>
                <Button Content="Cancel" Width="75" Click="Cancel_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
