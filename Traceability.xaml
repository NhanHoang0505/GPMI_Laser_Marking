<Window x:Class="GPMI_Laser_Marking.Traceability"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GPMI_Laser_Marking"
        mc:Ignorable="d"
        FontSize="14"
        WindowState="Maximized"
        Title="Traceability" Height="800" Width="1280">
    <Window.Resources>
        <Style TargetType="RadioButton">
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1.1" ScaleY="1.1"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.Resources>
                <Style  TargetType="{x:Type RadioButton}">
                    <Setter Property="BorderThickness" Value="1"></Setter>
                    <Setter Property="BorderBrush" Value="Blue"></Setter>
                    <Setter Property="FontSize" Value="15"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Margin" Value="20 0"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="Orange"/>
                            <Setter Property="Foreground" Value="Purple"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Background" Value="Orange"/>
                            <Setter Property="Foreground" Value="Blue"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Grid.Resources>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="5" VerticalAlignment="Center">Enter Value</TextBlock>
                    <TextBox Width="300" x:Name="Search_value_txt" HorizontalAlignment="Stretch" Margin="10 3" VerticalContentAlignment="Center" KeyDown="Search_value_txt_KeyDown" />
                    <Button Width="100" x:Name="Search_btn" Content="Search" Grid.Column="1" Margin=" 3" Click="Search_btn_Click"/>
                    <Button  x:Name="Export_btn" Content="Export to Csv" Width="100" Margin="20 3" Padding="5" Click="Export_btn_Click"/>
                    <TextBlock VerticalAlignment="Center" Margin="20 5">From</TextBlock>
                    <DatePicker Name="fromdate_dp" VerticalAlignment="Center"  Height="30"/>
                    <TextBlock VerticalAlignment="Center"  Margin="5">To</TextBlock>
                    <DatePicker Name="todate_dp" VerticalAlignment="Center"  Height="30"/>
                </StackPanel>

            </Grid>

            
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton  x:Name="OrderNo_rbtn" Content="Order No" IsChecked="True"/>
                <RadioButton  x:Name="Part_Number_rbtn" Content="Part Number" IsChecked="True" />
                <ComboBox Name="fqa_cbx" Width="80" SelectedIndex="0">
                    <ComboBoxItem Content="All"/>
                    <ComboBoxItem Content="OK"/>
                    <ComboBoxItem Content="NG"/>
                    <ComboBoxItem Content="UnFQA"/>
                </ComboBox>
                <RadioButton x:Name="Packaging_rbtn" Content="Packaging ID (QR Code)"/>
                <RadioButton x:Name="Part_ID_rbtn" Content="Part ID"/>
                <RadioButton x:Name="Ship_rbtn" Content="Shipping Code"/>
                <RadioButton x:Name="Con_rbtn" Content="ContainerID"/>

                <!--<Button Width="50" Click="Button_Click"></Button>-->

                
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="4" HorizontalAlignment="Right">
                <TextBlock x:Name="Couterpcs_tbl" VerticalAlignment="Center">pcs</TextBlock>
                <Button Margin="10 5" x:Name="back_btn" Width="24" Height="24" Background="Transparent" BorderThickness="0" RenderTransformOrigin="0.5,0.5" Click="Back_btn_Click">
                    <Button.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="1.5" ScaleY="1.5"/>
                        </TransformGroup>
                    </Button.RenderTransform>
                    <Grid Width="24" Height="24" >
                        <Path Fill="Black" Data="M14,7L9,12L14,17V7Z" />
                    </Grid>
                </Button>
                <Label x:Name="curentpage_lbl" VerticalAlignment="Center" HorizontalAlignment="Right">$$$</Label>
                <Label  VerticalAlignment="Center" HorizontalAlignment="Right">/</Label>
                <Label x:Name="Allpage_lbl" VerticalAlignment="Center" HorizontalAlignment="Left">$$$</Label>
                <Button Margin="10 5" x:Name="next_btn" Width="24" Height="24" Background="Transparent" BorderThickness="0" RenderTransformOrigin="0.5,0.5" Click="Next_btn_Click">
                    <Button.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="1.5" ScaleY="1.5"/>
                        </TransformGroup>
                    </Button.RenderTransform>
                    <Grid Width="24" Height="24" >
                        <Path Fill="Black" Data="M10,17L15,12L10,7V17Z" />
                    </Grid>
                </Button>
            </StackPanel>
        </Grid>
        <DataGrid x:Name="gird" Grid.Row="1" FontSize="12" AlternatingRowBackground="Wheat" LoadingRow="gird_LoadingRow" SelectedCellsChanged="Gird_SelectedCellsChanged">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="LightBlue"/>
                    <Setter Property="Height" Value="30"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="5 0"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="BorderBrush" Value="Black"/>
                </Style>
                <Style TargetType="DataGridCell">
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="5 0"/>
                    <Setter Property="BorderThickness" Value="3"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </DataGrid.ItemsPanel>
        </DataGrid>
    </Grid>
</Window>
