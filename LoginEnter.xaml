<Window x:Class="GPMI_Laser_Marking.LoginEnter"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GPMI_Laser_Marking"
        mc:Ignorable="d"
        FontSize="15"
        WindowStartupLocation="CenterScreen"
        Title="" Height="220" Width="300">
    <Grid>
        <Grid.Resources>
            <Style TargetType="TextBox" >
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="10 0"/>
                <Setter Property="Height" Value="30"/>
            </Style>
            <Style TargetType="TextBlock" >
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="10 0"/>
                
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="3*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Viewbox Width="36" Height="36" VerticalAlignment="Top">
                <Canvas Width="24" Height="24">
                    <Path Fill="Black" Data="M12,19.2C9.5,19.2 7.29,17.92 6,16C6.03,14 10,12.9 12,12.9C14,12.9 17.97,14 18,16C16.71,17.92 14.5,19.2 12,19.2M12,5A3,3 0 0,1 15,8A3,3 0 0,1 12,11A3,3 0 0,1 9,8A3,3 0 0,1 12,5M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12C22,6.47 17.5,2 12,2Z" />
                </Canvas>
            </Viewbox>
            
            <TextBlock Margin="20 0" VerticalAlignment="Top" FontSize="25" FontWeight="Bold">Login</TextBlock>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="95"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <TextBlock>Account ID</TextBlock>
                <TextBox x:Name="ID_txt" Grid.Column="1"></TextBox>
            </Grid>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="95"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <TextBlock>Password</TextBlock>
                <PasswordBox x:Name="PW_pbx" Margin="10" Height="30" VerticalContentAlignment="Center" VerticalAlignment="Center" Grid.Column="1" KeyDown="PW_pbx_KeyDown"></PasswordBox>
            </Grid>
            <Button x:Name="Login_btn" Grid.Row="2" Margin="100 5 80 10" Click="Login_btn_Click">Login</Button>
        </Grid>
    </Grid>
</Window>
