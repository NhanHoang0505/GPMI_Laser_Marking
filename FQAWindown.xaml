<Window x:Class="GPMI_Laser_Marking.FQAWindown"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GPMI_Laser_Marking"       
        mc:Ignorable="d"
        FontSize="15"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Title="FQA" Height="800" Width="1280" Closed="Window_Closed">
    <Grid Background="WhiteSmoke">
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!--Header View-->
        <Grid Grid.Row="0" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                <Viewbox Width="48" Height="48">
                    <Canvas Width="24" Height="24">
                        <Path Fill="Black" Data="M20,16V10H22V16A2,2 0 0,1 20,18H8C6.89,18 6,17.1 6,16V4C6,2.89 6.89,2 8,2H16V4H8V16H20M10.91,7.08L14,10.17L20.59,3.58L22,5L14,13L9.5,8.5L10.91,7.08M16,20V22H4A2,2 0 0,1 2,20V7H4V20H16Z" />
                    </Canvas>
                </Viewbox>
                <TextBlock Margin="20 0" Text="GPMI FQA CHECKING STATION" Style="{StaticResource HeaderTextBlock}" Foreground="DarkCyan"/>

            </StackPanel>


            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" >
                <Grid Margin="5 0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock VerticalAlignment="Center" Margin="10 0" x:Name="ID_tbx" FontSize="15"></TextBlock>
                    <TextBlock Grid.Row="1" VerticalAlignment="Center" Margin="10 0" x:Name="Name_tbx" FontSize="15"></TextBlock>
                </Grid>
            </StackPanel>
        </Grid>

        <!--Header View-->

        <!--Main View-->
        <Border Grid.Row="1" Background="{StaticResource TEMAS_LIGHT_GREY}" CornerRadius="15" Margin="5 0 5 5">
            <Grid Margin="5">

                <Grid.Resources>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource NormalTextBlock}"/>
                    <Style TargetType="TextBox" BasedOn="{StaticResource NormalTextBox}"/>
                </Grid.Resources>
                <Grid.RowDefinitions>
                    <RowDefinition Height="269"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="1" Margin="5" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="7*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Output History" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="20"/>
                    <DataGrid x:Name="Output_Grid" BorderThickness="2"  Grid.Row="2" FontSize="15" AutoGenerateColumns="False" CanUserAddRows="False" LoadingRow="Output_Grid_LoadingRow">
                        <DataGrid.Columns>
  
                            <DataGridTextColumn Header="Part Number" Width="*" Binding="{Binding Part_Number}"/>
                            <DataGridTextColumn Header="Part ID" Width="2.2*" Binding="{Binding Part_ID}"/>
                            <DataGridTextColumn Header="FQA Status" Width="*" Binding="{Binding FQA_Status}"/>
                            <DataGridTextColumn Header="Date Time" Width="*" Binding="{Binding Date_Time_FQA}"/>
                            <DataGridTextColumn Header="FQA Account" Width="*" Binding="{Binding FQA_Account}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>


                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>
                    <!--Main View Left-->
                    <Border Margin="5" CornerRadius="10" BorderThickness="1" BorderBrush="Black">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Order Input" FontWeight="Bold" FontSize="25"/>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="2*"/>
                                   
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="OrderNo_tbx"  Text="Order No"/>
                                <TextBlock x:Name="OrderNo_tbl" Text="{Binding}"  Grid.Column="1"/>
                            </Grid>
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="2*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Part Number"/> 
                                <TextBlock x:Name="PartNumber_tbx" Text="{Binding}"  Grid.Column="1"/>
                            </Grid>
                            <Grid Grid.Row="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="2*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Part Name"/>
                                <TextBlock x:Name="PartName_tbx" Text="{Binding}"  Grid.Column="1"/>
                            </Grid>
                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="2*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Version"/>
                                <TextBlock x:Name="Version_tbx" Text="{Binding }" Grid.Column="1"/>
                            </Grid>
                            <Grid Grid.Row="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="2*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Vender Code"/>
                                <TextBlock x:Name="VenderCode_tbx" Text="{Binding }" Grid.Column="1"/>

                            </Grid>
                            <Grid Grid.Row="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="2*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Order Date"/>
                                <TextBlock x:Name="OrderDate_tbx" Text="{Binding }" Grid.Column="1"/>
                            </Grid>
                            <Grid Grid.Row="7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="2*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Quantity"/>
                                <TextBlock x:Name="Quantity_tbx" Text="{Binding }" Grid.Column="1"/>
                            </Grid>
                        </Grid>

                    </Border>

                    <!--Main View Left-->

                    <!--Main View Right-->
                    <Border Grid.Column="1" Margin="5" CornerRadius="10" BorderThickness="1" BorderBrush="Black">
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="60"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="40"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="FQA Checking Confirm" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Top"
                                   FontSize="25"
                                   FontWeight="Bold"/>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="4*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Read Barcode" HorizontalAlignment="Center" Foreground="Green" FontWeight="Bold"/>
                                <TextBox x:Name="ReadPartID_txt"  FontSize="25" Grid.Column="1" FontStyle="Italic" KeyDown="ReadPartID_txt_KeyDown" />

                            </Grid>
                            <TextBlock Grid.Row="2"  x:Name="StatusPart_tbl" VerticalAlignment="Center" HorizontalAlignment="Center"></TextBlock>
                            <Grid x:Name="Status_grid" Grid.Row="3" IsEnabled="False">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="OK_btn" Grid.Column="1" Foreground="Green" FontSize="25" FontWeight="Bold" Style="{StaticResource Button_Number}" Margin=" 20" Click="OK_btn_Click">OK</Button>
                                <Button x:Name="NG_btn" Grid.Column="2" Foreground="DarkRed" FontSize="25" FontWeight="Bold" Style="{StaticResource Button_Number}" Margin="20" Click="NG_btn_Click">NG</Button>
                                <Button x:Name="Return_btn" Grid.Column="0"  FontSize="25" FontWeight="Bold" Style="{StaticResource Button_Number}" Margin=" 30 20" Click="Return_btn_Click" Content="Cancel"/>
                                <Button x:Name="Rewwork_btn" Grid.Column="3" Foreground="Green" FontSize="25" FontWeight="Bold" Style="{StaticResource Button_Number}" Margin="20"  Content="Rework" Click="Rewwork_btn_Click"/>

                            </Grid>
                            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="OK" HorizontalAlignment="Left"  Foreground="Green" FontWeight="Bold"/>
                                <TextBox x:Name="OK_txt" IsReadOnly="True" Width="100" />
                                <TextBlock Margin="30">|</TextBlock>
                                <TextBlock Text="NG" FontWeight="Bold" Foreground="{StaticResource TEMAS_RED}"/>
                                <TextBox x:Name="NG_txt" IsReadOnly="True" Width="100" />
                                <Button x:Name="Traceability_btn" Content="Traceability" Margin="20 0" Width="200" Height="32" FontSize="19" Click="Traceability_btn_Click"/>
                            </StackPanel>



                        </Grid>
                    </Border>


                    <!--Main View Right-->
                    <!--<StackPanel >
                        <TextBox x:Name="NCU_txt" Text="{Binding NCU}" />
                        <TextBox x:Name="SoPO_txt" Text="{Binding MSoPO}" />
                        <TextBox x:Name="MaSP_txt" Text="{Binding MaSP}" />
                        <TextBox x:Name="ReviewBV_txt" Text="{Binding ReviewBV}" />
                        <TextBox x:Name="MaKhac_txt" >
                            <MultiBinding StringFormat="{}{0}{1}{2}{3}">
                                <Binding Path="NCU" Mode="OneWayToSource" />
                                <Binding Path="MSoPO" Mode="OneWay" />
                                <Binding Path="MaSP" Mode="OneWay" />
                                <Binding Path="ReviewBV" Mode="OneWay" />
                            </MultiBinding>
                        </TextBox>
                        <Button x:Name="button" Content="Button" Click="button_Click"/>
                    </StackPanel>-->
                    <!--<Button Grid.Row="7" Width="150"
                            Height="35"
                            Command="{Binding PowerCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Status" />
                            <Rectangle Margin="5,2,0,0"
                            Width="10"
                            Height="10"
                            Fill="{Binding PowerFill}" />
                            <AccessText Margin="25,0,0,0"
                            Text="{Binding PowerText}" />
                        </StackPanel>
                    </Button>-->
                </Grid>

            </Grid>

        </Border>
        <!--Main View-->

        <!--TaskBar View -->
        <Grid Grid.Row="2" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel HorizontalAlignment="Center" Grid.Column="1" Orientation="Horizontal" Margin="5"/>
        </Grid>
        <!--TaskBar View -->
    </Grid>

</Window>
